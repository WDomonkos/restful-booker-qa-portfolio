        {
          "name": "POST – Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Booking created successfully\", function() {\n    pm.expect(pm.response.code).to.eql(200);\n})\nconst response = pm.response.json();\n\npm.test(\"Booking ID is a number\", function() {\n    pm.expect(typeof response.bookingid).to.eql(\"number\");\n});\n\npm.test(\"Booking ID is greater than zero\", function() {\n    pm.expect(response.bookingid).to.be.above(0);\n});\n\npm.test(\"Test price matches request\", function() {\n    pm.expect(response.booking.totalprice).to.eql(250);\n})\n\npm.test(\"First name matches request\", function() {\n    pm.expect(response.booking.firstname).to.eql(\"John\")\n})\n\nconst bookingId = response.bookingid;\npm.collectionVariables.set(\"bookingId\", bookingId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"John\",\n  \"lastname\": \"Smith\",\n  \"totalprice\": 250,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-12-10\",\n    \"checkout\": \"2026-12-15\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://restful-booker.herokuapp.com/booking",
              "protocol": "https",
              "host": [
                "restful-booker",
                "herokuapp",
                "com"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET – Get Booking by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();\n\npm.test(\"Get booking returns 200\", function() {\n    pm.expect(pm.response.code).to.eql(200);\n});\n\npm.test(\"First name is a string\", function() {\n    pm.expect(response.firstname).to.be.a(\"string\");\n});\n\npm.test(\"Total price is a number\", function() {\n    pm.expect(response.totalprice).to.be.a(\"number\");\n})\n\npm.test(\"Firstname is not empty\", function() {\n    pm.expect(response.firstname.length).to.be.above(0);\n})"
                ]
              }
            }
          ],
